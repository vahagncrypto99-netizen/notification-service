{
    "openapi": "3.0.0",
    "info": {
        "title": "Notification Service API",
        "description": "Сервис уведомлений: создание уведомлений, асинхронная доставка в каналы (email, telegram) с гарантией доставки, отчёты по уведомлениям пользователя за период.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api",
            "description": "REST API"
        }
    ],
    "paths": {
        "/health": {
            "get": {
                "tags": [
                    "Служебное"
                ],
                "summary": "Readiness-проверка сервиса",
                "description": "Состояние зависимостей (БД, брокер, кэш). Без аутентификации — для оркестратора/мониторинга.",
                "operationId": "63ca574ccc7f0d914cdced2f70f30b57",
                "responses": {
                    "200": {
                        "description": "Сервис здоров",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Сервис здоров."
                                        },
                                        "payload": {
                                            "properties": {
                                                "checks": {
                                                    "properties": {
                                                        "database": {
                                                            "type": "boolean",
                                                            "example": true
                                                        },
                                                        "queue": {
                                                            "type": "boolean",
                                                            "example": true
                                                        },
                                                        "cache": {
                                                            "type": "boolean",
                                                            "example": true
                                                        }
                                                    },
                                                    "type": "object"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Зависимость нездорова",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/notifications": {
            "get": {
                "tags": [
                    "Уведомления"
                ],
                "summary": "История уведомлений пользователя",
                "description": "История уведомлений пользователя с фильтрами по статусу и каналу.",
                "operationId": "0f031f66cd8c52bf73e89fb2d050ad83",
                "parameters": [
                    {
                        "name": "user_id",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "processing",
                                "sent",
                                "failed"
                            ]
                        }
                    },
                    {
                        "name": "channel",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "email",
                                "telegram"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "История с пагинацией",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "История уведомлений."
                                        },
                                        "payload": {
                                            "properties": {
                                                "notifications": {
                                                    "type": "array",
                                                    "items": {
                                                        "$ref": "#/components/schemas/Notification"
                                                    }
                                                },
                                                "pagination": {
                                                    "$ref": "#/components/schemas/Pagination"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Не аутентифицирован",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearer_token": [],
                        "request_timestamp": [],
                        "request_signature": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Уведомления"
                ],
                "summary": "Создать уведомление",
                "description": "Создаёт уведомление в статусе processing и ставит доставку в очередь.",
                "operationId": "258ba7c348fd4283c6b3802a69fe2fb0",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "message",
                                    "user_id",
                                    "channel"
                                ],
                                "properties": {
                                    "message": {
                                        "type": "string",
                                        "example": "Ваш заказ подтверждён",
                                        "maxLength": 500
                                    },
                                    "user_id": {
                                        "type": "integer",
                                        "example": 42,
                                        "minimum": 1
                                    },
                                    "channel": {
                                        "type": "string",
                                        "example": "email",
                                        "enum": [
                                            "email",
                                            "telegram"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Уведомление создано",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Уведомление создано."
                                        },
                                        "payload": {
                                            "properties": {
                                                "notification": {
                                                    "$ref": "#/components/schemas/Notification"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Не аутентифицирован",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearer_token": [],
                        "request_timestamp": [],
                        "request_signature": []
                    }
                ]
            }
        },
        "/notifications/{notification_id}": {
            "get": {
                "tags": [
                    "Уведомления"
                ],
                "summary": "Статус уведомления",
                "description": "Статус уведомления.",
                "operationId": "083b76cc83a3e6fd49b4d2e82b5e0efe",
                "parameters": [
                    {
                        "name": "notification_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Уведомление",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Уведомление получено."
                                        },
                                        "payload": {
                                            "properties": {
                                                "notification": {
                                                    "$ref": "#/components/schemas/Notification"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Не найдено",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Не аутентифицирован",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearer_token": [],
                        "request_timestamp": [],
                        "request_signature": []
                    }
                ]
            }
        },
        "/reports": {
            "post": {
                "tags": [
                    "Отчёты"
                ],
                "summary": "Запросить генерацию отчёта",
                "description": "Создаёт отчёт в статусе pending; генерация выполняется асинхронно.",
                "operationId": "c7626d5955385dd59028b35e8e17f362",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "user_id",
                                    "period_from",
                                    "period_to"
                                ],
                                "properties": {
                                    "user_id": {
                                        "type": "integer",
                                        "example": 42,
                                        "minimum": 1
                                    },
                                    "period_from": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-07-01"
                                    },
                                    "period_to": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-08-01"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Генерация запрошена",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Генерация отчёта запрошена."
                                        },
                                        "payload": {
                                            "properties": {
                                                "report": {
                                                    "$ref": "#/components/schemas/Report"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Не аутентифицирован",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearer_token": [],
                        "request_timestamp": [],
                        "request_signature": []
                    }
                ]
            }
        },
        "/reports/{report_id}": {
            "get": {
                "tags": [
                    "Отчёты"
                ],
                "summary": "Статус готовности отчёта",
                "description": "Статус готовности отчёта.",
                "operationId": "b7214efd44385cc01be9ad5b813899b9",
                "parameters": [
                    {
                        "name": "report_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Отчёт",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Отчёт получен."
                                        },
                                        "payload": {
                                            "properties": {
                                                "report": {
                                                    "$ref": "#/components/schemas/Report"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Не найден",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Не аутентифицирован",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearer_token": [],
                        "request_timestamp": [],
                        "request_signature": []
                    }
                ]
            }
        },
        "/reports/{report_id}/download": {
            "get": {
                "tags": [
                    "Отчёты"
                ],
                "summary": "Скачать готовый отчёт",
                "description": "Отдаёт файл отчёта; до готовности отвечает 409.",
                "operationId": "7a04052b1b672285ad8ce5f3d5082af4",
                "parameters": [
                    {
                        "name": "report_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "CSV-файл отчёта",
                        "content": {
                            "text/csv": {}
                        }
                    },
                    "409": {
                        "description": "Отчёт не готов",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Не найден",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Не аутентифицирован",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearer_token": [],
                        "request_timestamp": [],
                        "request_signature": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "Report": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "user_id": {
                        "type": "integer",
                        "example": 42
                    },
                    "period_from": {
                        "type": "string",
                        "format": "date",
                        "example": "2026-07-01"
                    },
                    "period_to": {
                        "type": "string",
                        "format": "date",
                        "example": "2026-08-01"
                    },
                    "status": {
                        "type": "string",
                        "example": "done",
                        "enum": [
                            "pending",
                            "processing",
                            "done",
                            "failed"
                        ]
                    },
                    "error": {
                        "type": "string",
                        "example": null,
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "Notification": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "message": {
                        "type": "string",
                        "example": "Ваш заказ подтверждён"
                    },
                    "status": {
                        "type": "string",
                        "example": "sent",
                        "enum": [
                            "processing",
                            "sent",
                            "failed"
                        ]
                    },
                    "user_id": {
                        "type": "integer",
                        "example": 42
                    },
                    "channel": {
                        "type": "string",
                        "example": "email",
                        "enum": [
                            "email",
                            "telegram"
                        ]
                    },
                    "attempts_count": {
                        "type": "integer",
                        "example": 1
                    },
                    "last_attempted_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "last_error": {
                        "type": "string",
                        "example": null,
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "ApiError": {
                "description": "Единый контракт ошибки",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": false
                    },
                    "message": {
                        "type": "string",
                        "example": "Уведомление не найдено."
                    },
                    "payload": {
                        "type": "object",
                        "example": []
                    }
                },
                "type": "object"
            },
            "ValidationError": {
                "description": "Единый контракт ошибки валидации",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": false
                    },
                    "message": {
                        "type": "string",
                        "example": "Ошибка валидации."
                    },
                    "payload": {
                        "properties": {
                            "errors": {
                                "type": "object",
                                "example": {
                                    "message": [
                                        "The message field is required."
                                    ]
                                }
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "Pagination": {
                "properties": {
                    "current_page": {
                        "type": "integer",
                        "example": 1
                    },
                    "per_page": {
                        "type": "integer",
                        "example": 15
                    },
                    "total": {
                        "type": "integer",
                        "example": 42
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "bearer_token": {
                "type": "http",
                "description": "Bearer-токен, идентифицирующий сервис-клиент (пары token:secret — в API_AUTH_CLIENTS).",
                "scheme": "bearer"
            },
            "request_timestamp": {
                "type": "apiKey",
                "description": "Unix-время запроса; окно валидности — API_SIGNATURE_TTL секунд (replay-защита).",
                "name": "X-Timestamp",
                "in": "header"
            },
            "request_signature": {
                "type": "apiKey",
                "description": "HMAC-подпись канонического запроса: hmac_sha256(secret, METHOD \\n URI \\n TIMESTAMP \\n BODY).",
                "name": "X-Signature",
                "in": "header"
            }
        }
    },

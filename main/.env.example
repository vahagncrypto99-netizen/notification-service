APP_NAME="Notification Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_STACK=stderr,sentry
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=notifications
DB_USERNAME=notifier
DB_PASSWORD=notifier

SESSION_DRIVER=array

FILESYSTEM_DISK=local
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

QUEUE_CONNECTION=rabbitmq

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=notifier
RABBITMQ_PASSWORD=notifier
RABBITMQ_VHOST=/

# Клиенты API: пары token:signing_secret через запятую (по одной на сервис-потребитель)
API_AUTH_CLIENTS=change-me-token:change-me-secret

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

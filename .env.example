# Compose
COMPOSE_PROJECT_NAME=notification-service

# Ownership (UID/GID хоста для файлов bind-mount: id -u / id -g)
UID=1000
GID=1000

# System
TZ=UTC

# Postgres
POSTGRES_FORWARD_PORT=5432
POSTGRES_DATABASE=notifications
POSTGRES_USERNAME=notifier
POSTGRES_PASSWORD=notifier
POSTGRES_VERSION=16-alpine

# RabbitMQ
RABBITMQ_MANAGEMENT_FORWARD_PORT=15672
RABBITMQ_VERSION=4-management-alpine
RABBITMQ_USER=notifier
RABBITMQ_PASSWORD=notifier

# Redis
REDIS_VERSION=7-alpine

# Nginx
NGINX_FORWARD_PORT=80
NGINX_VERSION=1.27-alpine
